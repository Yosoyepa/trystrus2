# ==============================================================================
# Aval (TryTrust) — Environment Variables & Google Gemini Integration
# ==============================================================================

# 1. Google Gemini API Key: Paste your key here
GEMINI_API_KEY=

# (Optional) Alternative Key names recognized
GOOGLE_API_KEY=
LLM_API_KEY=

# 2. Model Selection (default: gemini-3.7-flash, or gemini-2.0-flash / gemini-1.5-pro)
LLM_MODEL=gemini-3.7-flash

# 3. Google Gemini Endpoint (OpenAI-compatible endpoint provided by Google Generative AI)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 4. Database configuration
POSTGRES_USER=aval
POSTGRES_PASSWORD=aval
POSTGRES_DB=aval
DATABASE_URL=postgresql://aval:aval@localhost:5432/aval
