[Unit]
Description=TryTrust recurrent search — one watcher tick
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/daniel/hackathons/Hackthon-Yuno-Nauta-
ExecStart=/home/daniel/.local/bin/uv run python -m src.agent.cli tick

# ── containment ────────────────────────────────────────────────────────────
# The tick talks to a model and a merchant. It has no business reading the
# home directory, writing outside var/, gaining privileges, or surviving a
# hang. Each line below removes something it never needed.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/daniel/hackathons/Hackthon-Yuno-Nauta-/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

# ── blast radius ───────────────────────────────────────────────────────────
# A tick that hangs is killed, not left to overlap with the next one. The
# single-flight lock in limits.py is the correctness answer; this is the
# belt-and-braces one.
TimeoutStartSec=50
MemoryMax=512M
TasksMax=32
CPUQuota=50%
